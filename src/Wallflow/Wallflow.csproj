<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Screen.AllScreens + SystemInformation.PowerStatus -->
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>wallflow</AssemblyName>
    <RootNamespace>Wallflow</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms sert uniquement à Screen/PowerStatus ; son global using casse les types WPF -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.3.0" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\lib\libmpv-2.dll" Link="libmpv-2.dll"
          CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\lib\libmpv-2.dll')" />
    <!-- ffmpeg ≥ 7.1 requis (décodage webp animé) — conversion GIF/webp → mp4 du cache -->
    <None Include="..\..\lib\ffmpeg.exe" Link="ffmpeg.exe"
          CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\lib\ffmpeg.exe')" />
  </ItemGroup>

</Project>
