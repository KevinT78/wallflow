<!--
    Habillage Vermillon de MainWindow (ticket #21, écart DESIGN.md "habillage Vermillon").
    Scopé à MainWindow.Resources (pas Application.Resources) : le tray reste sur le thème
    Fluent/Dark global, intouché visuellement — seule la fenêtre lit ces clés, car la résolution
    DynamicResource remonte l'arbre visuel et trouve ces overrides avant d'atteindre Application.
    Valeurs : docs/design/vermillon-tokens.md. Ombres dures = DropShadowEffect BlurRadius=0.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <FontFamily x:Key="VermillonTitleFont">./Fonts/#Shippori Mincho</FontFamily>

    <Color x:Key="VermillonCreme">#F4F2F0</Color>
    <Color x:Key="VermillonEncre">#0E0D12</Color>
    <Color x:Key="VermillonAccent">#FF3B21</Color>
    <Color x:Key="VermillonAccentHover">#FF5A2B</Color>
    <Color x:Key="VermillonAccentPressed">#E42A16</Color>
    <Color x:Key="VermillonAccentTint">#FFF3F0</Color>
    <Color x:Key="VermillonLavandeTint">#E4E0EA</Color>
    <Color x:Key="VermillonLavandeDark">#5B5470</Color>
    <SolidColorBrush x:Key="VermillonEncreBrush" Color="{StaticResource VermillonEncre}" />
    <SolidColorBrush x:Key="VermillonAccentBrush" Color="{StaticResource VermillonAccent}" />

    <!--  Ombre portée dure : offset net, zéro flou (à l'opposé du DropShadow Fluent standard)  -->
    <DropShadowEffect x:Key="VermillonHardShadow" Color="{StaticResource VermillonEncre}"
                       Direction="315" ShadowDepth="4" BlurRadius="0" Opacity="1" />

    <!--  Fondations  -->
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="{StaticResource VermillonCreme}" />
    <SolidColorBrush x:Key="WindowBackground" Color="{StaticResource VermillonCreme}" />
    <SolidColorBrush x:Key="WindowForeground" Color="{StaticResource VermillonEncre}" />
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource VermillonEncre}" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource VermillonLavandeDark}" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="{StaticResource VermillonLavandeDark}" />
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="{StaticResource VermillonLavandeTint}" />

    <!--  Button (natif ET ui:Button partagent ces clés)  -->
    <SolidColorBrush x:Key="ButtonBackground" Color="White" />
    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{StaticResource VermillonAccentTint}" />
    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{StaticResource VermillonLavandeTint}" />
    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#E9E7E4" />
    <SolidColorBrush x:Key="ButtonForeground" Color="{StaticResource VermillonEncre}" />
    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{StaticResource VermillonEncre}" />
    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{StaticResource VermillonEncre}" />
    <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="{StaticResource VermillonLavandeDark}" />
    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="{StaticResource VermillonEncre}" />
    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="{StaticResource VermillonLavandeTint}" />
    <SolidColorBrush x:Key="AccentButtonBackground" Color="{StaticResource VermillonAccent}" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="{StaticResource VermillonAccentHover}" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="{StaticResource VermillonAccentPressed}" />

    <!--  ToggleSwitch  -->
    <SolidColorBrush x:Key="ToggleSwitchContentForeground" Color="{StaticResource VermillonEncre}" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="{StaticResource VermillonLavandeDark}" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="{StaticResource VermillonAccent}" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="{StaticResource VermillonAccentHover}" />
    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="{StaticResource VermillonAccent}" />
    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="{StaticResource VermillonAccentHover}" />
    <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="White" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="{StaticResource VermillonLavandeDark}" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="White" />

    <!--  RadioButton  -->
    <SolidColorBrush x:Key="RadioButtonForeground" Color="{StaticResource VermillonEncre}" />
    <SolidColorBrush x:Key="RadioButtonOuterEllipseFill" Color="White" />
    <SolidColorBrush x:Key="RadioButtonOuterEllipseStroke" Color="{StaticResource VermillonLavandeDark}" />
    <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStroke" Color="{StaticResource VermillonAccent}" />
    <SolidColorBrush x:Key="RadioButtonCheckGlyphFill" Color="{StaticResource VermillonAccent}" />

    <!--  Separator  -->
    <SolidColorBrush x:Key="SeparatorBorderBrush" Color="{StaticResource VermillonLavandeTint}" />

    <!--  Flyout / Snackbar / ToolTip / ContextMenu — surfaces flottantes de la fenêtre  -->
    <SolidColorBrush x:Key="FlyoutBackground" Color="White" />
    <SolidColorBrush x:Key="FlyoutBorderBrush" Color="{StaticResource VermillonEncre}" />
    <SolidColorBrush x:Key="SnackBarBackground" Color="White" />
    <SolidColorBrush x:Key="SnackBarForeground" Color="{StaticResource VermillonEncre}" />
    <SolidColorBrush x:Key="SnackBarBorderBrush" Color="{StaticResource VermillonEncre}" />
    <SolidColorBrush x:Key="ToolTipBackground" Color="{StaticResource VermillonEncre}" />
    <SolidColorBrush x:Key="ToolTipForeground" Color="White" />
    <SolidColorBrush x:Key="ContextMenuBackground" Color="White" />
    <SolidColorBrush x:Key="ContextMenuBorderBrush" Color="{StaticResource VermillonEncre}" />
    <SolidColorBrush x:Key="ContextMenuForeground" Color="{StaticResource VermillonEncre}" />

    <!--  ScrollBar de la grille des récents  -->
    <SolidColorBrush x:Key="ScrollBarButtonArrowForeground" Color="{StaticResource VermillonLavandeDark}" />
    <SolidColorBrush x:Key="ScrollBarThumbFill" Color="{StaticResource VermillonLavandeDark}" />

</ResourceDictionary>
